# Copy this file to .env, next to docker-compose.yml, and fill in the values.
# .env is ignored by git: never commit it.

# PostgreSQL superuser password. Required: `docker compose` refuses to start
# without it. It is used by the postgres service and by the updater's
# connection string.
# The postgres image only applies POSTGRES_* the first time it initialises an
# empty postgres_data/ directory; changing this value later does not change the
# password of an existing database.
POSTGRES_PASSWORD=

# Optional. The defaults match the existing production database; only set them
# when creating a fresh one.
#POSTGRES_USER=root
#POSTGRES_DB=arequipa_db
